{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "mcp__.*github.*__create_pull_request",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-pr-gate.mjs\"",
						"timeout": 15
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"if": "Bash(gh pr create*)",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-pr-gate.mjs\"",
						"timeout": 15
					}
				]
			}
		]
	}
}
