# Скопировать в .env.local (локально) или задать в Vercel → Settings → Environment Variables.

# Адрес API для сервера Next и прокси /api/* (next.config.ts). Только сервер, в бандл не попадает.
# Локально — бэкенд из cofelier-backend; на Vercel — домен Railway.
BACKEND_URL=http://localhost:4000

# Адрес API для WebSocket (Vercel его не проксирует). Публичный — попадает в бандл.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
