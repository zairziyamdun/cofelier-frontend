  "info": {
    "title": "Cofelier API",
    "description": "API кофейни Cofelier: меню, вход, заказы",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "schemas": {
      "MenuItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 3
          },
          "name": {
            "type": "string",
            "example": "Капучино"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Эспрессо, молоко и шелковистая пенка"
          },
          "portion": {
            "type": "string",
            "nullable": true,
            "example": "300 мл"
          },
          "price": {
            "type": "number",
            "description": "Цена в целых тенге",
            "example": 1500
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "isAvailable": {
            "type": "boolean",
            "description": "false — позиция в стоп-листе: видна, но заказать нельзя"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "portion",
          "price",
          "imageUrl",
          "isAvailable"
        ]
      },
      "MenuCategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "slug": {
            "type": "string",
            "example": "espresso"
          },
          "name": {
            "type": "string",
            "example": "Эспрессо и классика"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuItemDto"
            }
          }
        },
        "required": ["id", "slug", "name", "items"]
      },
      "ManagedMenuItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 3
          },
          "name": {
            "type": "string",
            "example": "Капучино"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Эспрессо, молоко и шелковистая пенка"
          },
          "portion": {
            "type": "string",
            "nullable": true,
            "example": "300 мл"
          },
          "price": {
            "type": "number",
            "description": "Цена в целых тенге",
            "example": 1500
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "isAvailable": {
            "type": "boolean",
            "description": "false — позиция в стоп-листе: видна, но заказать нельзя"
          },
          "categoryId": {
            "type": "number",
            "example": 1
          },
          "inStopList": {
            "type": "boolean",
            "description": "true — позиция в стоп-листе"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "portion",
          "price",
          "imageUrl",
          "isAvailable",
          "categoryId",
          "inStopList"
        ]
      },
      "ManagedMenuCategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "slug": {
            "type": "string",
            "example": "espresso"
          },
          "name": {
            "type": "string",
            "example": "Эспрессо и классика"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ManagedMenuItemDto"
            }
          }
        },
        "required": ["id", "slug", "name", "items"]
      },
      "CreateMenuItemDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Капучино"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Эспрессо, молоко и шелковистая пенка"
          },
          "portion": {
            "type": "string",
            "nullable": true,
            "example": "300 мл"
          },
          "price": {
            "type": "number",
            "description": "Цена в целых тенге",
            "example": 1500
          }
        },
        "required": ["categoryId", "name", "price"]
      },
      "UpdateMenuItemDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Капучино"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Эспрессо, молоко и шелковистая пенка"
          },
          "portion": {
            "type": "string",
            "nullable": true,
            "example": "300 мл"
          },
          "price": {
            "type": "number",
            "description": "Цена в целых тенге",
            "example": 1500
          }
        }
      },
      "SetStopListDto": {
        "type": "object",
        "properties": {
          "inStopList": {
            "type": "boolean",
            "description": "true — позиция в стоп-листе"
          }
        },
        "required": ["inStopList"]
      },
      "CreateMenuCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Сезонное"
          }
        },
        "required": ["name"]
      },
      "ReorderMenuCategoriesDto": {
        "type": "object",
        "properties": {
          "ids": {
            "description": "id всех категорий в новом порядке",
            "example": [3, 1, 2],
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": ["ids"]
      },
      "UpdateMenuCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Сезонное"
          }
        },
        "required": ["name"]
      },
      "Role": {
        "type": "string",
        "enum": ["client", "barista", "manager", "admin"]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "email": {
            "type": "string",
            "example": "anna@example.com"
          },
          "name": {
            "type": "string",
            "example": "Анна"
          },
          "role": {
            "example": "client",
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          }
        },
        "required": ["id", "email", "name", "role"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "anna@example.com"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery"
          }
        },
        "required": ["email", "password"]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Анна"
          },
          "email": {
            "type": "string",
            "example": "anna@example.com"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery",
            "minLength": 8
          }
        },
        "required": ["name", "email", "password"]
      }
    }
  }
}
