  "info": {
    "title": "Cofelier API",
    "description": "API кофейни Cofelier: меню, вход, заказы",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "schemas": {
      "MenuItemBadge": {
        "type": "string",
        "enum": ["popular", "new", "seasonal", "signature", "decaf"],
        "description": "Метки для карточки по порядку важности: popular и new считает сервер, остальные ставит менеджер"
      },
      "MenuItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 3
          },
          "name": {
            "type": "string",
            "example": "Капучино"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Эспрессо, молоко и шелковистая пенка"
          },
          "portion": {
            "type": "string",
            "nullable": true,
            "example": "300 мл"
          },
          "price": {
            "type": "number",
            "description": "Цена в целых тенге",
            "example": 1500
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "isAvailable": {
            "type": "boolean",
            "description": "false — позиция в стоп-листе: видна, но заказать нельзя"
          },
          "badges": {
            "type": "array",
            "description": "Метки для карточки по порядку важности: popular и new считает сервер, остальные ставит менеджер",
            "example": ["popular", "seasonal"],
            "items": {
              "$ref": "#/components/schemas/MenuItemBadge"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "portion",
          "price",
          "imageUrl",
          "isAvailable",
          "badges"
        ]
      },
      "MenuCategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "slug": {
            "type": "string",
            "example": "espresso"
          },
          "name": {
            "type": "string",
            "example": "Эспрессо и классика"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuItemDto"
            }
          }
        },
